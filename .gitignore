# ============================================
#   PROJECT-SPECIFIC — THE IMPORTANT PART
# ============================================

# --- Ignore all local DB files EXCEPT users.db ---
*.db
*.sqlite
!data/users.db

# --- Ignore all ML model artifacts, except the 4 needed files ---
data/ml/*
!data/ml/best_model.pkl
!data/ml/vectorizer.pkl
!data/ml/metrics.json
!data/ml/known_texts.txt

# --- DO NOT ignore config.json inside data ---
!data/config.json

# --- Ignore logs ---
logs/
*.log
*.tmp

# --- Ignore datasets ---
data/ml_dataset.csv

# --- Ignore local ads file (optional) ---
data/ads_text.txt
